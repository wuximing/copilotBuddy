{
  "name": "copilot-buddy",
  "displayName": "WorkBuddy for Copilot Chat",
  "description": "%description%",
  "publisher": "wuximing",
  "version": "0.4.0",
  "license": "MIT",
  "icon": "assets/icon/icon.png",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "workbuddy",
        "displayName": "WorkBuddy",
        "managementCommand": "copilotBuddy.manage"
      },
      {
        "vendor": "workbuddy-ai",
        "displayName": "WorkBuddy AI",
        "managementCommand": "copilotBuddy.manageAI"
      }
    ],
    "commands": [
      {
        "command": "copilotBuddy.manage",
        "title": "%command.manage.title%"
      },
      {
        "command": "copilotBuddy.manageAI",
        "title": "%command.manageAI.title%"
      }
    ],
    "configuration": {
      "title": "WorkBuddy for Copilot Chat",
      "properties": {
        "workbuddy.authFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.authFile%"
        },
        "workbuddy.aiAuthFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.aiAuthFile%"
        },
        "workbuddy.electronBinary": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.electronBinary%"
        },
        "workbuddy.aiElectronBinary": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.aiElectronBinary%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "test": "node dist/test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0"
  }
}
